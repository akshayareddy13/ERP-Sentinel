# ---- Backend ----
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_pw@db:5432/erp_sentinel
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_PER_MINUTE=10
ENVIRONMENT=development
# Public sign-up (creates VIEWER accounts). Keep false; admins create users under /api/users.
ALLOW_SELF_REGISTRATION=false
# Optional AI analyst narration (leave empty to use the built-in fact-based answers)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Guest verification and protected audit backups ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=erp-sentinel@example.com
# Mount this path from separately administered backup storage.
AUDIT_BACKUP_DIR=
# Use a distinct random secret stored outside the database host. Empty falls back to JWT_SECRET.
AUDIT_SIGNING_KEY=
# Set a stable secret so guest MFA enrollment survives application restarts/JWT rotation.
GUEST_MFA_ENCRYPTION_KEY=

# ---- Postgres container ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_pw
POSTGRES_DB=erp_sentinel

# ---- Frontend (public, never put secrets here) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
